---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProfileCard from './bento/ProfileCard.astro';
import FeaturedCard from './bento/FeaturedCard.astro';
import StackCard from './bento/StackCard.astro';
import ContributionsCard from './bento/ContributionsCard.astro';
import LocationCard from './bento/LocationCard.astro';
import ContactCard from './bento/ContactCard.astro';
import type { Locale } from '../i18n/ui';

interface Props { locale: Locale }
const { locale } = Astro.props;
---

<BaseLayout locale={locale}>
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
    <ProfileCard locale={locale} />
    <FeaturedCard locale={locale} />
    <StackCard locale={locale} />
    <ContributionsCard locale={locale} />
    <LocationCard locale={locale} />
    <ContactCard locale={locale} />
  </div>
</BaseLayout>
