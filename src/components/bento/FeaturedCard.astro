---
import Card from './Card.astro';
import { getUi, type Locale } from '../../i18n/ui';
import { site } from '../../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getUi(locale).featured;
---

<Card class="flex flex-col justify-between gap-8 lg:col-span-7">
  <div>
    <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-accent">{t.label}</p>
    <h2 class="text-3xl font-bold tracking-tight">{t.title}</h2>
    <p class="mt-3 max-w-xl leading-relaxed text-muted">{t.description}</p>
    <ul class="mt-5 flex flex-wrap gap-2">
      {
        site.featuredRepo.tags.map((tag) => (
          <li class="rounded-full border border-line px-3 py-1 text-sm text-ink/90">{tag}</li>
        ))
      }
    </ul>
  </div>
  <div>
    <a
      href={site.featuredRepo.href}
      class="inline-flex items-center gap-2 rounded-xl border border-line px-5 py-3 font-semibold transition-colors hover:border-accent hover:text-accent"
    >
      {t.source}
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</Card>
