---
import FeaturedCarousel from '../FeaturedCarousel';
import { getUi, type Locale } from '../../i18n/ui';
import { site } from '../../data/site';

// Project images live in src/assets/featured/<name>.webp; Vite resolves them to hashed URLs.
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/featured/*.webp', { eager: true });

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getUi(locale).featured;
const slides = site.featured.map((project) => ({
  id: project.id,
  title: project.title,
  description: t.descriptions[project.id as keyof typeof t.descriptions],
  tags: [...project.tags],
  href: project.href,
  image: images[`../../assets/featured/${project.image}.webp`].default.src,
}));
---

<FeaturedCarousel
  client:load
  className="md:col-span-1 lg:col-span-7"
  slides={slides}
  label={t.label}
  source={t.source}
  carouselLabel={t.carouselLabel}
/>
