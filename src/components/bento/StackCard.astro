---
import Card from './Card.astro';
import StackLoop from '../StackLoop';
import { getUi, type Locale } from '../../i18n/ui';
import { site } from '../../data/site';
import { getIconSvg } from '../../lib/icons';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getUi(locale).stack;
const items = site.stack.map((item) => ({ name: item.name, color: item.color, svg: getIconSvg(`brands/${item.icon}`) }));
---

<Card class="md:col-span-1 lg:col-span-4">
  <h2 class="text-xl font-bold">{t.title}</h2>
  <p class="mt-1 text-sm text-muted fit:short:hidden">{t.subtitle}</p>
  <div class="mt-6 fit:mt-[1.4dvh]">
    <StackLoop client:load items={items} label={t.title} />
  </div>
</Card>
