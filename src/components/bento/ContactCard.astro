---
import Card from './Card.astro';
import ContactDock from '../ContactDock';
import { getUi, type Locale } from '../../i18n/ui';
import { site } from '../../data/site';
import { getIconSvg } from '../../lib/icons';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getUi(locale).contact;
const contacts = site.contactLinks.map((link) => ({ label: link.label, href: link.href, svg: getIconSvg(link.icon) }));
---

<Card effect="glare" class="md:col-span-2 md:order-5 lg:order-none lg:col-span-7" inner="flex h-full flex-col justify-between gap-6 fit:flex-row fit:items-center fit:gap-4">
  <div class="min-w-0 fit:w-1/2">
    <h2 class="text-3xl font-bold tracking-tight fit:text-[clamp(1.4rem,4.2dvh,2.25rem)]">
      <span class="sr-only">{t.title}: </span>
      {t.heading}
    </h2>
    <p class="mt-2 max-w-md text-muted fit:short:hidden">{t.text}</p>
  </div>
  <div class="relative h-24 w-full fit:h-full fit:w-1/2">
    <ContactDock client:load contacts={contacts} />
  </div>
</Card>
