---
import Card from './Card.astro';
import { getUi, type Locale } from '../../i18n/ui';
import { site } from '../../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getUi(locale).contact;
const labels: Record<string, string> = { github: t.github };
---

<Card class="flex flex-col justify-between gap-6 lg:col-span-7">
  <div>
    <h2 class="text-xl font-bold">{t.title}</h2>
    <p class="mt-2 max-w-md text-muted">{t.text}</p>
  </div>
  <ul class="flex flex-wrap gap-3">
    {
      site.contactLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="inline-flex items-center gap-2 rounded-xl bg-accent px-5 py-3 font-semibold text-accent-ink transition-opacity hover:opacity-90"
          >
            {labels[link.id] ?? link.id}
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</Card>
