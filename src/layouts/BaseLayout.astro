---
import '../styles/global.css';
import { getUi, locales, pathFor, type Locale } from '../i18n/ui';
import { site } from '../data/site';
import Icon from '../components/Icon.astro';
import LanguageSelect from '../components/LanguageSelect.astro';
import EffectsBackground from '../components/EffectsBackground';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getUi(locale);
const current = Astro.url.pathname;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={pathFor(l)} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="fit:h-dvh fit:overflow-hidden">
    <EffectsBackground client:load />
    <div class="mx-auto flex w-full max-w-[1600px] flex-col px-4 pb-8 pt-4 sm:px-6 fit:h-full fit:pb-4">
      <header class="relative z-20 mb-4 flex shrink-0 items-center justify-between fit:mb-3">
        <a href={pathFor(locale)} class="text-lg font-bold tracking-tight">
          <span class="text-accent">&lt;/&gt;</span> {site.name}
        </a>
        <nav aria-label={t.navLabel} class="hidden items-center gap-1 md:flex">
          {
            site.nav.map((item) => {
              const href = `${pathFor(locale)}${item.slug}`;
              const active = current === href || current === `${href}/`;
              return (
                <a
                  href={href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
                    active ? 'text-accent' : 'text-muted hover:text-ink',
                  ]}
                >
                  {t.nav[item.id as keyof typeof t.nav]}
                </a>
              );
            })
          }
        </nav>
        <div class="flex items-center gap-2">
          <LanguageSelect locale={locale} />
          <a
            href={site.url}
            aria-label={t.githubLabel}
            class="inline-flex items-center gap-2 rounded-lg border border-line px-3 py-1.5 text-sm font-semibold transition-colors hover:border-accent hover:text-accent"
          >
            <Icon name="brands/github" class="size-4" />
            <span class="hidden sm:inline">{t.githubLabel}</span>
            <span aria-hidden="true" class="hidden sm:inline">↗</span>
          </a>
        </div>
      </header>
      <main class="fit:min-h-0 fit:flex-1">
        <slot />
      </main>
      <footer class="mt-8 text-center text-sm text-muted fit:hidden">{t.footer}</footer>
    </div>
  </body>
</html>
