---
import '../styles/global.css';
import { getUi, locales, pathFor, type Locale } from '../i18n/ui';
import { site } from '../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getUi(locale);
const other: Locale = locale === 'es' ? 'en' : 'es';
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.metaTitle}</title>
    <meta name="description" content={t.metaDescription} />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={t.metaTitle} />
    <meta property="og:description" content={t.metaDescription} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={pathFor(l)} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="mx-auto w-full max-w-6xl px-4 pb-12 pt-6 sm:px-6">
      <header class="mb-6 flex items-center justify-between">
        <a href={pathFor(locale)} class="text-lg font-bold tracking-tight">
          <span class="text-accent">&lt;/&gt;</span> {site.name}
        </a>
        <nav aria-label={t.switchLabel}>
          <a
            href={pathFor(other)}
            hreflang={other}
            lang={other}
            class="rounded-lg border border-line px-3 py-1.5 text-sm font-semibold uppercase transition-colors hover:border-accent hover:text-accent"
          >
            {other}
          </a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="mt-8 text-center text-sm text-muted">{t.footer}</footer>
    </div>
  </body>
</html>
